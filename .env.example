# Copy this file to .env and fill in values.
# Never commit a real .env file.

# --- MySQL (application user: full access to churn_db) ---
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=churn_db
MYSQL_USER=churn_app
MYSQL_PASSWORD=change_this_app_password
DATABASE_URL=mysql+pymysql://churn_app:change_this_app_password@localhost:3306/churn_db

# --- MySQL (chatbot user: SELECT only on customers/predictions/segments) ---
CHATBOT_DB_USER=chatbot_user
CHATBOT_DB_PASSWORD=change_this_chatbot_password
CHATBOT_DATABASE_URL=mysql+pymysql://chatbot_user:change_this_chatbot_password@localhost:3306/churn_db

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- App ---
BACKEND_URL=http://localhost:8000
SEED_ON_STARTUP=true
CSV_PATH=data/WA_Fn-UseC_-Telco-Customer-Churn.csv
MODELS_DIR=models

# --- LLM (required for the AI Assistant; leave blank to disable chat) ---
# LLM_PROVIDER: openai | groq | openai_compatible
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional. Groq default is https://api.groq.com/openai/v1
# OpenAI default is https://api.openai.com/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
